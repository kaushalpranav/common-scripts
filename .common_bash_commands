function gi() {
  echo '======'
  echo $(lightgreen status)
  echo '======'
  gs
  echo '=========='
  echo $(lightgreen commit log)
  echo '=========='
  gl -2
  echo '=============='
  echo $(lightgreen current branch)
  echo '=============='
  gcb
}

